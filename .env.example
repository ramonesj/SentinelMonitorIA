# SentinelMonitorIA Environment Variables
# Copy to .env and fill with your values

# Application
APP_NAME="SentinelMonitorIA"
ENVIRONMENT="development"  # local, development, staging, production
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL="INFO"

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security
SECRET_KEY="change-this-to-a-secure-random-string"
JWT_SECRET_KEY="change-this-to-a-secure-jwt-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="sentinelmonitoria"
POSTGRES_USER="sentinel"
POSTGRES_PASSWORD="change-this-password"
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis (Cache & Rate Limiting)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# AWS Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# S3 Buckets
S3_TELEMETRY_BUCKET="sentinelmonitoria-telemetry"
S3_LOGS_BUCKET="sentinelmonitoria-logs"
S3_BACKUP_BUCKET="sentinelmonitoria-backups"

# SQS Queues
SQS_TELEMETRY_QUEUE_URL=""
SQS_ALERTS_QUEUE_URL=""

# Bedrock / S3 Vectors (AWS phase 19)
AI_PROVIDER="rules"
AI_MODEL_ID="amazon.nova-lite-v1:0"
AI_KNOWLEDGE_BASE_ID=""
AI_ENABLE_ACTIONS="false"
NOTIFICATION_CHANNELS="log"

# Email & Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@sentinelmonitoria.com"

# Slack Integration
SLACK_WEBHOOK_URL=""
SLACK_BOT_TOKEN=""

# Discord Integration
DISCORD_WEBHOOK_URL=""

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# Telemetry Ingestion
TELEMETRY_BATCH_SIZE=1000
TELEMETRY_BUFFER_SIZE=10000
TELEMETRY_FLUSH_INTERVAL=5  # seconds

# Health Checks
HEALTH_CHECK_TIMEOUT=5  # seconds
HEALTH_CHECK_RETRIES=3