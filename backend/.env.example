# SentinelMonitorIA Backend Environment Variables
# Copy to .env for local development

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
SECRET_KEY=development-secret-key-change-in-production
JWT_SECRET_KEY=development-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelmonitoria
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0
REDIS_STREAM_PREFIX=sentinel:stream
REDIS_STREAM_MAX_LENGTH=10000
REDIS_STREAM_CONSUMER_GROUP=sentinel-telemetry-workers
TELEMETRY_STALE_BATCH_SECONDS=3600
REDIS_DEAD_LETTER_REPLAY_KEY=sentinel:stream:dead_letter:replayed

# Telemetry Processing
TELEMETRY_BATCH_SIZE=1000
TELEMETRY_BUFFER_SIZE=10000
TELEMETRY_FLUSH_INTERVAL=5

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_ORGANIZATION_REQUESTS=1000

# Queue Configuration (Mock for local development)
QUEUE_PROVIDER=mock
MOCK_QUEUE_MAX_SIZE=10000

# AWS Configuration (for future use)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# SQS Configuration (for future use)
SQS_TELEMETRY_QUEUE_URL=
SQS_ALERTS_QUEUE_URL=
SQS_DEAD_LETTER_QUEUE_URL=

# Intelligence and RAG
AI_PROVIDER=rules
AI_MODEL_ID=
AI_MODEL_NAME=llama3.2
AI_OLLAMA_BASE_URL=http://localhost:11434
AI_KNOWLEDGE_BASE_ID=
AI_LOG_ARCHIVE_BUCKET=
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_FINDINGS=20
AI_REQUEST_TIMEOUT_SECONDS=30
AI_ENABLE_ACTIONS=false
ANOMALY_CPU_THRESHOLD=90
ANOMALY_MEMORY_THRESHOLD=90

# Provider-neutral chatbot (rules or Lex V2 + optional Bedrock)
CHAT_PROVIDER=rules
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=
LEX_LOCALE_ID=es_419
CHAT_CONTEXT_ALERT_LIMIT=20
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_ENABLE_ACTIONS=false
AI_ANALYSIS_CONSUMER_GROUP=sentinel-ai-analysis-workers
NOTIFICATION_CONSUMER_GROUP=sentinel-notification-workers

# Notifications (leave channels=log until destinations are configured)
NOTIFICATION_CHANNELS=log
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_SLACK_WEBHOOK_URL=
NOTIFICATION_DISCORD_WEBHOOK_URL=
NOTIFICATION_TEAMS_WEBHOOK_URL=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_REQUEST_TIMEOUT_SECONDS=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ALERT_WEBSOCKET_POLL_SECONDS=2

# Health Checks
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3