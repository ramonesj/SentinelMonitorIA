# SentinelMonitorIA Backend Environment Variables
# Copy to .env for local development

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
SECRET_KEY=development-secret-key-change-in-production
JWT_SECRET_KEY=development-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelmonitoria
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_PREFIX=sentinel:stream
REDIS_STREAM_MAX_LENGTH=10000
REDIS_STREAM_CONSUMER_GROUP=sentinel-telemetry-workers
TELEMETRY_STALE_BATCH_SECONDS=3600
REDIS_DEAD_LETTER_REPLAY_KEY=sentinel:stream:dead_letter:replayed

# Telemetry Processing
TELEMETRY_BATCH_SIZE=1000
TELEMETRY_BUFFER_SIZE=10000
TELEMETRY_FLUSH_INTERVAL=5

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_ORGANIZATION_REQUESTS=1000

# Queue Configuration (Mock for local development)
QUEUE_PROVIDER=mock
MOCK_QUEUE_MAX_SIZE=10000

# AWS Configuration (for future use)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# SQS Configuration (for future use)
SQS_TELEMETRY_QUEUE_URL=
SQS_ALERTS_QUEUE_URL=
SQS_DEAD_LETTER_QUEUE_URL=

# Health Checks
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3