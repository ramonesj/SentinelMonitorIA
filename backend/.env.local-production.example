# Copy this file to .env.local-production and replace every security placeholder.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=local-production
DEBUG=false
LOG_LEVEL=info
API_WORKERS=2
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_DB=sentinelmonitoria
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_TLS=false
REDIS_DB=0

QUEUE_PROVIDER=mock
MOCK_QUEUE_MAX_SIZE=10000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_ORGANIZATION_REQUESTS=1000

# Intelligence and notifications
AI_PROVIDER=rules
AI_MODEL_ID=
AI_MODEL_NAME=llama3.2
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_KNOWLEDGE_BASE_ID=
AI_ENABLE_ACTIONS=false
AI_ANALYSIS_CONSUMER_GROUP=sentinel-ai-analysis-workers
NOTIFICATION_CONSUMER_GROUP=sentinel-notification-workers
NOTIFICATION_CHANNELS=log
NOTIFICATION_EMAIL_TO=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_SLACK_WEBHOOK_URL=
NOTIFICATION_DISCORD_WEBHOOK_URL=
NOTIFICATION_TEAMS_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=replace-with-a-notification-signing-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Chatbot
CHAT_PROVIDER=rules
CHAT_CONTEXT_ALERT_LIMIT=20
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_ENABLE_ACTIONS=false
