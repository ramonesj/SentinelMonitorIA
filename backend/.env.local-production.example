# Copy this file to .env.local-production and replace every security placeholder.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=local-production
DEBUG=false
LOG_LEVEL=info
API_WORKERS=2
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_DB=sentinelmonitoria
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_DB=0

QUEUE_PROVIDER=mock
MOCK_QUEUE_MAX_SIZE=10000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
RATE_LIMIT_ORGANIZATION_REQUESTS=1000
